# =====================================================================
# AegisProcure AI — Environment Configuration
# =====================================================================

# Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# Optional LLM API Keys (Supports Gemini / OpenAI for natural language reasoning)
# If left blank, AegisProcure AI automatically utilizes its built-in high-precision
# deterministic domain policy solver to run out of the box with zero external dependencies.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Autonomy Mode ("autonomous" or "human_in_the_loop")
DEFAULT_AUTONOMY_MODE=autonomous
